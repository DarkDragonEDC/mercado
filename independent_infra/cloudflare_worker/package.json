{
  "name": "albionmkt-license-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "discord:register": "node scripts/register-discord-commands.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^22.15.17",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.32.0"
  }
}
